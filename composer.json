{
    "name": "cancio-labs/cpf-doctrine-type",
    "description": "A custom mapping type for Brazilian CPF (Cadastro de Pessoas Físicas).",
    "type": "library",
    "keywords": ["doctrine", "type", "mapping type", "brazil", "cpf"],
    "homepage": "https://github.com/canciolabs/cpf-doctrine-type",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Nilo Soares",
            "email": "nilosoares@gmail.com"
        },
        {
            "name": "Cancio Labs",
            "email": "canciolabs@gmail.com"
        },
        {
            "name": "NSCPS Solutions",
            "email": "nscpssolutions@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "CancioLabs\\Doctrine\\Type\\Cpf\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CancioLabs\\Doctrine\\Type\\Cpf\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.5",
        "doctrine/dbal": "^4.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3"
    },
    "scripts": {
        "tests": [
            "vendor/bin/phpunit"
        ],
        "coverage": [
            "XDEBUG_MODE=coverage vendor/bin/phpunit --coverage-html=coverage"
        ]
    }
}
